{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "GitHub": {
    "CacheMinutes": 10,
    "PartialResultCacheMinutes": 2,
    "MaxLanguageRepositories": 100,
    "ReservedRequests": 5,
    "MaxParallelRequests": 5,
    "MaxRepositoryPages": 5,
    "RequestTimeoutSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "PermitsPerMinute": 120
  },
  "ReverseProxy": {
    "Enabled": false
  }
}
